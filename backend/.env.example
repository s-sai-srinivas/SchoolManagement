# Database
DATABASE_URL="postgresql://user:password@localhost:5432/database_name?schema=public"

# JWT Secrets (Generate strong random strings for production)
JWT_SECRET="change-this-to-a-strong-random-string-min-32-characters"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_SECRET="change-this-to-another-strong-random-string-min-32-characters"
JWT_REFRESH_EXPIRY="7d"

# Server Configuration
PORT=3001
NODE_ENV="development"

# AWS S3 Configuration
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET="your-s3-bucket-name"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Email Service (SendGrid or AWS SES)
SENDGRID_API_KEY="your-sendgrid-api-key"
FROM_EMAIL="noreply@yourschool.com"

# Frontend URL (for CORS configuration)
FRONTEND_URL="http://localhost:3003"
