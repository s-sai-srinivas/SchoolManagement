// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== CORE MODELS ====================

model School {
  id        String    @id @default(uuid())
  name      String
  logoUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete
  
  users              User[]
  students           Student[]
  feeStructures      FeeStructure[]
  homework           Homework[]
  notices            Notice[]
  teacherAssignments TeacherAssignment[]

  @@index([deletedAt])
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String    // bcrypt hashed with salt rounds = 12
  name      String
  role      UserRole
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete
  
  // Relations
  studentParents     StudentParent[]
  teacherAssignments TeacherAssignment[]
  attendanceMarked   Attendance[]
  homeworkPosted     Homework[]       @relation("HomeworkPosted")
  noticesPosted      Notice[]         @relation("NoticePosted")
  notifications      Notification[]

  @@index([email])
  @@index([schoolId, role])
  @@index([deletedAt])
}

enum UserRole {
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

model Student {
  id          String    @id @default(uuid())
  admissionNo String    @unique
  name        String
  class       String
  section     String
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete
  
  // Relations
  parents     StudentParent[]
  attendance  Attendance[]
  feePayments FeePayment[]

  @@index([schoolId, class, section])
  @@index([admissionNo])
  @@index([deletedAt])
}

// Many-to-many relationship: Student ↔ Parent
model StudentParent {
  id           String       @id @default(uuid())
  studentId    String
  parentId     String
  relationType RelationType @default(PARENT)
  createdAt    DateTime     @default(now())
  
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([parentId])
  @@index([studentId])
}

enum RelationType {
  FATHER
  MOTHER
  GUARDIAN
  PARENT // Generic
}

// Teacher → Class/Section assignments
model TeacherAssignment {
  id        String   @id @default(uuid())
  teacherId String
  schoolId  String
  class     String
  section   String
  subject   String?  // Optional: specific subject
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  teacher User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school  School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([teacherId, class, section, subject])
  @@index([teacherId])
  @@index([schoolId, class, section])
}

// ==================== ATTENDANCE ====================

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  date      DateTime         @db.Date // Date-only, no time
  status    AttendanceStatus
  markedBy  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [markedBy], references: [id])

  @@unique([studentId, date]) // Prevent duplicate attendance
  @@index([date]) // For daily reports
  @@index([studentId, date]) // Composite for student history
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

// ==================== FEES & PAYMENTS ====================

model FeeStructure {
  id                String   @id @default(uuid())
  schoolId          String
  annualAmountPaise Int      // Store as integer paise (₹10,000 = 1000000 paise)
  installments      Int
  installmentDates  Json     // Array of date strings
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model FeePayment {
  id                String        @id @default(uuid())
  studentId         String
  amountPaise       Int           // Amount in paise
  installmentNo     Int
  razorpayOrderId   String?       @unique // Prevent duplicate orders
  razorpayPaymentId String?       @unique // Prevent duplicate payments
  razorpaySignature String?
  status            PaymentStatus @default(PENDING)
  paymentMode       PaymentMode? // CASH or CHEQUE for manual payments
  receiptUrl        String?
  receiptNumber     String?       @unique // Auto-generated
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMode {
  CASH
  CHEQUE
}

// ==================== HOMEWORK ====================

model Homework {
  id          String    @id @default(uuid())
  class       String
  section     String
  subject     String
  description String    @db.Text
  imageUrl    String?   // S3 URL
  postedBy    String
  schoolId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete
  
  teacher User   @relation("HomeworkPosted", fields: [postedBy], references: [id])
  school  School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, class, section])
  @@index([createdAt])
  @@index([deletedAt])
}


// ==================== NOTICES ====================

model Notice {
  id          String    @id @default(uuid())
  schoolId    String
  title       String
  description String    @db.Text
  postedBy    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete
  
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  admin  User   @relation("NoticePosted", fields: [postedBy], references: [id])

  @@index([schoolId])
  @@index([createdAt])
  @@index([deletedAt])
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  metadata  Json?            // Additional data (studentId, homeworkId, etc.)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

enum NotificationType {
  ATTENDANCE_ABSENT
  HOMEWORK_POSTED
  NOTICE_POSTED
  FEE_REMINDER
  FEE_PAYMENT_SUCCESS
}

// ==================== REFRESH TOKENS ====================

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique // Hashed token
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}
